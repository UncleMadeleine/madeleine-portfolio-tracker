    { "symbol": "NVDA", "lists": ["科技", "美股"], "upper_1": 260, "lower_1": 200, "note": "关注" },
    { "symbol": "600036.SS", "lists": ["银行", "A股"], "upper_1": 55, "lower_1": 38, "note": "A股示例" },
    { "symbol": "BTC-USD", "lists": ["加密"], "note": "无阈值仅跟踪" }
  ]
